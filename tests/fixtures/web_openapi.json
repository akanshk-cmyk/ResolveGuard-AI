{
  "components": {
    "schemas": {
      "DemoCallbackRequest": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "title": "Consent",
            "type": "boolean"
          },
          "handoff_ref": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Handoff Ref",
            "type": "string"
          },
          "request_key": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Request Key",
            "type": "string"
          }
        },
        "required": [
          "handoff_ref",
          "request_key",
          "consent"
        ],
        "title": "DemoCallbackRequest",
        "type": "object"
      },
      "DemoSettings": {
        "additionalProperties": false,
        "properties": {
          "profile": {
            "default": "signed-out",
            "enum": [
              "customer-one",
              "customer-two",
              "signed-out",
              "expired",
              "needs-verification",
              "bow-customer-one",
              "bow-customer-two",
              "bow-needs-verification",
              "bow-revoked",
              "bow-unauthenticated"
            ],
            "title": "Profile",
            "type": "string"
          },
          "queue_failure": {
            "default": "none",
            "enum": [
              "none",
              "primary",
              "all"
            ],
            "title": "Queue Failure",
            "type": "string"
          }
        },
        "title": "DemoSettings",
        "type": "object"
      },
      "DemoSignIn": {
        "additionalProperties": false,
        "properties": {
          "pending_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Id"
          },
          "profile": {
            "default": "customer-one",
            "enum": [
              "customer-one",
              "customer-two",
              "needs-verification",
              "bow-customer-one",
              "bow-customer-two",
              "bow-needs-verification"
            ],
            "title": "Profile",
            "type": "string"
          }
        },
        "title": "DemoSignIn",
        "type": "object"
      },
      "DemoVerification": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "confirm",
              "cancel"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "DemoVerification",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NewConversationSettings": {
        "additionalProperties": false,
        "properties": {
          "guest": {
            "default": false,
            "title": "Guest",
            "type": "boolean"
          }
        },
        "title": "NewConversationSettings",
        "type": "object"
      },
      "ResumeRequest": {
        "additionalProperties": false,
        "properties": {
          "pending_id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Pending Id",
            "type": "string"
          }
        },
        "required": [
          "pending_id"
        ],
        "title": "ResumeRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebTurn": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "action": {
            "default": "message",
            "enum": [
              "message",
              "confirm",
              "cancel"
            ],
            "title": "Action",
            "type": "string"
          },
          "bank_id": {
            "default": "LEGACY_DEMO",
            "enum": [
              "LEGACY_DEMO",
              "BOW"
            ],
            "title": "Bank Id",
            "type": "string"
          },
          "case_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "draft_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id"
          },
          "message": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "product": {
            "default": "DEBIT_CHECKING",
            "enum": [
              "CHECKING",
              "DEBIT_CHECKING"
            ],
            "title": "Product",
            "type": "string"
          },
          "product_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "request_key": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Request Key",
            "type": "string"
          },
          "thread_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "transaction_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            "maxLength": 20,
            "title": "Transaction Ids",
            "type": "array"
          }
        },
        "required": [
          "message",
          "request_key"
        ],
        "title": "WebTurn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ResolveGuard synthetic demo",
    "version": "0.1.0"
  },
