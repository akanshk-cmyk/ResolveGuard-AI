      "discriminator": {
        "mapping": {
          "CONFLICT": "#/$defs/HandoffConflict",
          "DENIED": "#/$defs/BlockedHandoff",
          "OK": "#/$defs/AcknowledgedHandoff",
          "UNKNOWN": "#/$defs/UnknownHandoff"
