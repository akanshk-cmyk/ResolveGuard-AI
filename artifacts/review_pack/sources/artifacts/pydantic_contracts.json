              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Reason Code",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason_code"
          ],
          "title": "HandoffConflict",
          "type": "object"
        },
        "HandoffPayload": {
          "additionalProperties": false,
          "properties": {
            "case_id": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Case Id"
            },
            "report_id": {
              "anyOf": [
                {
                  "pattern": "^DEMO-REPORT-[0-9a-f]{16}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Report Id"
            }
          },
          "title": "HandoffPayload",
          "type": "object"
        },
        "UnknownHandoff": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "UNKNOWN",
              "title": "Status",
              "type": "string"
            },
            "handoff_status": {
              "enum": [
                "UNAVAILABLE",
                "DELIVERY_UNKNOWN"
              ],
              "title": "Handoff Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "payload": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HandoffPayload"
