{
  "version": "pydantic-boundaries-v1",
  "note": "Shape validation is not authorization or proof of committed effects. JSON array-to-tuple normalization is explicit; other value coercion is disabled.",
  "schemas": {
    "Request": {
      "additionalProperties": false,
      "description": "Trusted caller supplies fixture identity; chat text cannot set authority.",
      "properties": {
        "message": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Key",
          "type": "string"
        },
        "session_id": {
          "default": "SESS-001",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Session Id",
          "type": "string"
        },
        "transaction_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxLength": 20,
          "title": "Transaction Ids",
          "type": "array"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "account_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "service_id": {
          "default": "resolveguard-agent",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Service Id",
          "type": "string"
        },
        "product": {
          "default": "DEBIT_CHECKING",
          "enum": [
            "CHECKING",
            "DEBIT_CHECKING"
          ],
          "title": "Product",
          "type": "string"
        },
        "jurisdiction": {
          "const": "US",
          "default": "US",
          "title": "Jurisdiction",
          "type": "string"
        }
      },
      "required": [
        "message",
        "request_key"
      ],
      "title": "Request",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "primary_intent": {
          "enum": [
            "FEE_INQUIRY",
            "POLICY_LOOKUP",
            "TRANSACTION_INQUIRY",
            "CASE_STATUS",
            "FRAUD_ERROR_REPORT",
            "SUPPORT_CASE_REQUEST",
            "HUMAN_REQUEST",
            "UNSUPPORTED_REQUEST",
            "OTHER_OR_UNCLEAR"
          ],
          "title": "Primary Intent",
          "type": "string"
        },
        "potential_fraud_error": {
          "title": "Potential Fraud Error",
          "type": "boolean"
        },
        "human_requested": {
          "title": "Human Requested",
          "type": "boolean"
        },
        "urgent": {
          "title": "Urgent",
          "type": "boolean"
        }
      },
      "required": [
        "primary_intent",
        "potential_fraud_error",
        "human_requested",
        "urgent"
      ],
      "title": "Route",
      "type": "object"
    },
    "Faults": {
      "additionalProperties": false,
      "description": "Mutable, assignment-validated simulator controls; never model-generated.",
      "properties": {
        "transaction_timeout": {
          "default": false,
          "title": "Transaction Timeout",
          "type": "boolean"
        },
        "case_timeout": {
          "default": false,
          "title": "Case Timeout",
          "type": "boolean"
        },
        "intake_timeout": {
          "default": false,
          "title": "Intake Timeout",
          "type": "boolean"
        },
        "intake_commit_then_timeout": {
          "default": false,
          "title": "Intake Commit Then Timeout",
          "type": "boolean"
        },
        "case_commit_then_timeout": {
          "default": false,
          "title": "Case Commit Then Timeout",
          "type": "boolean"
        },
        "primary_queue_down": {
          "default": false,
          "title": "Primary Queue Down",
          "type": "boolean"
        },
        "backup_queue_down": {
          "default": false,
          "title": "Backup Queue Down",
          "type": "boolean"
        },
        "handoff_timeout": {
          "default": false,
          "title": "Handoff Timeout",
          "type": "boolean"
        },
        "receiver_denied": {
          "default": false,
          "title": "Receiver Denied",
          "type": "boolean"
        },
        "receiver_fields": {
          "default": [
            "case_id",
            "report_id"
          ],
          "items": {
            "enum": [
              "case_id",
              "report_id"
            ],
            "type": "string"
          },
          "maxLength": 2,
          "title": "Receiver Fields",
          "type": "array"
        },
        "handoff_status_query": {
          "default": false,
          "title": "Handoff Status Query",
          "type": "boolean"
        },
        "step_up_verified": {
          "default": false,
          "title": "Step Up Verified",
          "type": "boolean"
        }
      },
      "title": "Faults",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "response": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Response",
          "type": "string"
        }
      },
      "required": [
        "response"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "transaction_result": {
      "$defs": {
        "ReadFailure": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "DENIED",
                "UNKNOWN"
              ],
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "data": {
              "default": null,
              "title": "Data",
              "type": "null"
            }
          },
          "required": [
            "status"
          ],
          "title": "ReadFailure",
          "type": "object"
        },
        "TransactionData": {
          "additionalProperties": false,
          "properties": {
            "transaction_id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Transaction Id",
              "type": "string"
            },
            "posted_on": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "Posted On",
              "type": "string"
            },
            "merchant": {
              "maxLength": 300,
              "minLength": 1,
              "title": "Merchant",
              "type": "string"
            },
            "amount_cents": {
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "title": "Amount Cents",
              "type": "integer"
            },
            "currency": {
              "const": "USD",
              "title": "Currency",
              "type": "string"
            },
            "status": {
              "enum": [
                "PENDING",
                "POSTED",
                "REVERSED",
                "DECLINED"
              ],
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "transaction_id",
            "posted_on",
            "merchant",
            "amount_cents",
            "currency",
            "status"
          ],
          "title": "TransactionData",
          "type": "object"
        },
        "TransactionSuccess": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "data": {
              "$ref": "#/$defs/TransactionData"
            }
          },
          "required": [
            "status",
            "data"
          ],
          "title": "TransactionSuccess",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "DENIED": "#/$defs/ReadFailure",
          "OK": "#/$defs/TransactionSuccess",
          "UNKNOWN": "#/$defs/ReadFailure"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TransactionSuccess"
        },
        {
          "$ref": "#/$defs/ReadFailure"
        }
      ]
    },
    "case_read_result": {
      "$defs": {
        "CaseData": {
          "additionalProperties": false,
          "properties": {
            "case_id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Case Id",
              "type": "string"
            },
            "case_type": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Case Type",
              "type": "string"
            },
            "status": {
              "enum": [
                "OPEN",
                "IN_REVIEW",
                "WAITING_FOR_CUSTOMER",
                "RESOLVED",
                "CLOSED"
              ],
              "title": "Status",
              "type": "string"
            },
            "created_at": {
              "maxLength": 40,
              "minLength": 20,
              "title": "Created At",
              "type": "string"
            },
            "owner_queue": {
              "enum": [
                "CUSTOMER_SUPPORT",
                "FRAUD_OPERATIONS"
              ],
              "title": "Owner Queue",
              "type": "string"
            }
          },
          "required": [
            "case_id",
            "case_type",
            "status",
            "created_at",
            "owner_queue"
          ],
          "title": "CaseData",
          "type": "object"
        },
        "CaseReadSuccess": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "data": {
              "$ref": "#/$defs/CaseData"
            }
          },
          "required": [
            "status",
            "data"
          ],
          "title": "CaseReadSuccess",
          "type": "object"
        },
        "ReadFailure": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "DENIED",
                "UNKNOWN"
              ],
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "data": {
              "default": null,
              "title": "Data",
              "type": "null"
            }
          },
          "required": [
            "status"
          ],
          "title": "ReadFailure",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "DENIED": "#/$defs/ReadFailure",
          "OK": "#/$defs/CaseReadSuccess",
          "UNKNOWN": "#/$defs/ReadFailure"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CaseReadSuccess"
        },
        {
          "$ref": "#/$defs/ReadFailure"
        }
      ]
    },
    "report_result": {
      "$defs": {
        "CapturedReport": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "report_capture_status": {
              "const": "CAPTURED",
              "title": "Report Capture Status",
              "type": "string"
            },
            "regulatory_notice_status": {
              "const": "REVIEW_REQUIRED",
              "title": "Regulatory Notice Status",
              "type": "string"
            },
            "reported_at": {
              "maxLength": 40,
              "minLength": 20,
              "title": "Reported At",
              "type": "string"
            },
            "verification_status": {
              "enum": [
                "VERIFIED",
                "PENDING"
              ],
              "title": "Verification Status",
              "type": "string"
            },
            "investigation_status": {
              "const": "NOT_STARTED",
              "title": "Investigation Status",
              "type": "string"
            },
            "customer_confirmation_status": {
              "const": "UNCONFIRMED",
              "title": "Customer Confirmation Status",
              "type": "string"
            },
            "event_id": {
              "pattern": "^DEMO-REPORT-[0-9a-f]{16}$",
              "title": "Event Id",
              "type": "string"
            },
            "replayed": {
              "title": "Replayed",
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "report_capture_status",
            "regulatory_notice_status",
            "reported_at",
            "verification_status",
            "investigation_status",
            "customer_confirmation_status",
            "event_id",
            "replayed"
          ],
          "title": "CapturedReport",
          "type": "object"
        },
        "WriteFailure": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "DENIED",
                "UNKNOWN",
                "CONFLICT"
              ],
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            }
          },
          "required": [
            "status"
          ],
          "title": "WriteFailure",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "CONFLICT": "#/$defs/WriteFailure",
          "DENIED": "#/$defs/WriteFailure",
          "OK": "#/$defs/CapturedReport",
          "UNKNOWN": "#/$defs/WriteFailure"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CapturedReport"
        },
        {
          "$ref": "#/$defs/WriteFailure"
        }
      ]
    },
    "case_write_result": {
      "$defs": {
        "CommittedCase": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "case_status": {
              "const": "OPEN",
              "title": "Case Status",
              "type": "string"
            },
            "committed_at": {
              "maxLength": 40,
              "minLength": 20,
              "title": "Committed At",
              "type": "string"
            },
            "event_id": {
              "pattern": "^DEMO-CASE-[0-9a-f]{16}$",
              "title": "Event Id",
              "type": "string"
            },
            "replayed": {
              "title": "Replayed",
