            "status"
          ],
          "title": "ConfirmationRequired",
          "type": "object"
        },
        "WriteFailure": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "DENIED",
                "UNKNOWN",
                "CONFLICT"
              ],
              "title": "Status",
              "type": "string"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            }
          },
          "required": [
            "status"
          ],
          "title": "WriteFailure",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "CONFIRMATION_REQUIRED": "#/$defs/ConfirmationRequired",
          "CONFLICT": "#/$defs/WriteFailure",
          "DENIED": "#/$defs/WriteFailure",
          "OK": "#/$defs/CommittedCase",
          "UNKNOWN": "#/$defs/WriteFailure"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CommittedCase"
        },
        {
          "$ref": "#/$defs/WriteFailure"
        },
        {
          "$ref": "#/$defs/ConfirmationRequired"
        }
      ]
    },
    "handoff_result": {
      "$defs": {
        "AcknowledgedHandoff": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "handoff_status": {
              "const": "ACKNOWLEDGED",
              "title": "Handoff Status",
              "type": "string"
            },
            "queue": {
              "enum": [
                "CUSTOMER_SUPPORT",
                "FRAUD_OPERATIONS",
                "FRAUD_BACKUP"
              ],
              "title": "Queue",
              "type": "string"
            },
            "alternate_route": {
              "title": "Alternate Route",
              "type": "boolean"
            },
            "payload": {
              "$ref": "#/$defs/HandoffPayload"
            },
            "event_id": {
              "pattern": "^DEMO-HANDOFF-[0-9a-f]{16}$",
              "title": "Event Id",
              "type": "string"
            },
            "replayed": {
