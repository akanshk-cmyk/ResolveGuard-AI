        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AcknowledgedHandoff"
        },
        {
          "$ref": "#/$defs/BlockedHandoff"
        },
        {
          "$ref": "#/$defs/UnknownHandoff"
        },
        {
          "$ref": "#/$defs/HandoffConflict"
        }
      ]
    },
    "policy_result": {
      "$defs": {
        "MissingPolicies": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "NOT_FOUND",
                "CONFLICT"
              ],
              "title": "Status",
              "type": "string"
            },
            "chunks": {
              "items": {
                "$ref": "#/$defs/PolicyChunk"
              },
              "maxItems": 0,
              "title": "Chunks",
              "type": "array"
            },
            "reason_code": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            }
          },
          "required": [
            "status",
            "chunks"
          ],
          "title": "MissingPolicies",
          "type": "object"
        },
        "PolicyChunk": {
          "additionalProperties": false,
          "properties": {
            "doc_id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Doc Id",
              "type": "string"
            },
            "title": {
              "maxLength": 20000,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "version": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Version",
              "type": "string"
            },
            "product": {
              "enum": [
                "ALL",
                "CHECKING",
                "DEBIT_CHECKING"
              ],
              "title": "Product",
              "type": "string"
            },
            "jurisdiction": {
              "const": "US",
              "title": "Jurisdiction",
              "type": "string"
            },
            "effective_date": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "title": "Effective Date",
              "type": "string"
            },
            "expires_at": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expires At"
            },
            "approval_status": {
              "const": "APPROVED_FOR_SYNTHETIC_TEST",
              "title": "Approval Status",
              "type": "string"
            },
            "chunk_id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "title": "Chunk Id",
              "type": "string"
            },
            "section": {
              "maxLength": 20000,
              "minLength": 1,
              "title": "Section",
              "type": "string"
            },
            "text": {
              "maxLength": 20000,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            },
            "token_count_approx": {
              "exclusiveMinimum": 0,
              "title": "Token Count Approx",
              "type": "integer"
            },
            "oversize_preserved": {
              "title": "Oversize Preserved",
              "type": "boolean"
            },
            "score": {
              "exclusiveMinimum": 0,
              "title": "Score",
              "type": "number"
            }
          },
          "required": [
            "doc_id",
            "title",
            "version",
            "product",
            "jurisdiction",
            "effective_date",
            "expires_at",
            "approval_status",
            "chunk_id",
            "section",
            "text",
            "token_count_approx",
            "oversize_preserved",
            "score"
          ],
          "title": "PolicyChunk",
          "type": "object"
        },
        "RetrievedPolicies": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "OK",
              "title": "Status",
              "type": "string"
            },
            "chunks": {
              "items": {
                "$ref": "#/$defs/PolicyChunk"
              },
              "maxItems": 5,
              "minItems": 1,
              "title": "Chunks",
              "type": "array"
            }
          },
          "required": [
            "status",
            "chunks"
          ],
          "title": "RetrievedPolicies",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "CONFLICT": "#/$defs/MissingPolicies",
          "NOT_FOUND": "#/$defs/MissingPolicies",
          "OK": "#/$defs/RetrievedPolicies"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RetrievedPolicies"
        },
        {
          "$ref": "#/$defs/MissingPolicies"
        }
      ]
    },
    "report_payload": {
      "additionalProperties": false,
      "properties": {
        "original_statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Original Statement",
          "type": "string"
        },
        "reported_transaction_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reported Transaction Ids",
          "type": "array"
        }
      },
      "required": [
        "original_statement",
        "reported_transaction_ids"
      ],
      "title": "ReportPayload",
      "type": "object"
    },
    "case_payload": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "account_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Account Id",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "account_id"
      ],
      "title": "CasePayload",
      "type": "object"
    },
    "handoff_payload": {
      "$defs": {
        "HandoffPayload": {
          "additionalProperties": false,
          "properties": {
            "case_id": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Case Id"
            },
            "report_id": {
              "anyOf": [
                {
                  "pattern": "^DEMO-REPORT-[0-9a-f]{16}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Report Id"
            }
          },
          "title": "HandoffPayload",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/HandoffPayload"
        },
        "queue": {
          "enum": [
            "CUSTOMER_SUPPORT",
            "FRAUD_OPERATIONS",
            "FRAUD_BACKUP"
          ],
          "title": "Queue",
          "type": "string"
        }
      },
      "required": [
        "payload",
        "queue"
      ],
      "title": "DeliveryPayload",
      "type": "object"
    }
  }
}
