# No environment variables are required for the offline synthetic demo.
# Copy this template to an untracked .env only when enabling optional features.
# Empty credential fields are placeholders; never commit filled-in values.

# Required only for explicitly enabled Nebius replies or semantic evaluations.
NEBIUS_API_KEY=
RESOLVEGUARD_REPLY_MODE=off

# Optional evaluator overrides; these are public model identifiers, not secrets.
RESOLVEGUARD_JUDGE_MODEL=zai-org/GLM-5.3-Flash
RESOLVEGUARD_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Optional LangSmith publishing/tracing. Keep disabled until separately enabled.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolveguard-demo-eval
LANGSMITH_TRACING=false
RESOLVEGUARD_CLOUD_TRACING=false
